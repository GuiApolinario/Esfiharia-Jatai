# Copie este arquivo para ".env" e ajuste conforme o seu servidor.
# Nenhuma variável é obrigatória: sem elas o site sobe com valores padrão.

# Porta em que o site roda
PORT=3000

# Usuário e senha do primeiro acesso ao painel.
# Só são usados na PRIMEIRA execução, quando ainda não existe administrador.
# Se você não definir a senha, o sistema gera uma e mostra no terminal.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Onde ficam o banco de dados e as fotos dos produtos.
# Aponte para um disco que NÃO seja apagado a cada atualização do servidor.
DATA_DIR=./data

# Use "production" quando o site estiver publicado.
NODE_ENV=production

# Marque o cookie de login como seguro (obrigatório em sites com HTTPS).
# Deixe "false" apenas se o site ainda estiver rodando em http://
SECURE_COOKIES=true

# Preencha com 1 quando o site estiver atrás de um proxy reverso
# (Nginx, Render, Railway, Fly.io, Cloudflare…).
TRUST_PROXY=1
